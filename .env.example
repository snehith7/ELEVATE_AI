# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (Atlas cloud URI e.g. mongodb+srv://... or local mongodb://...)
# If left blank, CodeElevate automatically runs using a robust persistent in-memory/file-backed MongoDB database engine.
MONGODB_URI=""

# JWT_SECRET: Secret for signing student & admin session tokens
JWT_SECRET="codeelevate-super-secret-key-change-in-prod"

# RESEND_API_KEY: Resend API key for sending email verification codes (e.g. re_123456789)
# Sign up and get your API key at https://resend.com
# In development or if left unset, verification codes are logged directly to the server terminal.
RESEND_API_KEY=""

# EMAIL_FROM: Sender email address for verification emails.
# IMPORTANT: Public webmail domains (such as @gmail.com, @yahoo.com) cannot be verified in Resend.
# Use 'CodeElevate Academy <onboarding@resend.dev>' for development/testing, or an address on your verified domain (e.g., 'noreply@yourdomain.com') in production.
EMAIL_FROM="CodeElevate Academy <onboarding@resend.dev>"

